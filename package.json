{
  "name": "namou",
  "private": true,
  "version": "1.1.0",
  "author": "aejone1013",
  "description": "namou - Restaurant Reservation System",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:clear-table-policies": "node --test --experimental-strip-types src/store/clearTablePolicies.test.ts",
    "test:move-policies": "node --test --experimental-strip-types src/store/movePolicies.test.ts",
    "test:merge-planner": "node --test --experimental-strip-types src/store/mergePlanner.test.ts",
    "test:planned-booking-policies": "node --test --experimental-strip-types src/store/plannedBookingPolicies.test.ts",
    "test:store-integration": "vitest run src/store/useReservationStore.integration.test.ts",
    "test:vitest": "vitest run src/store/useReservationStore.integration.test.ts",
    "check": "npm run typecheck && npm run test:planned-booking-policies && npm run test:store-integration && npm run electron:compile && npm run build",
    "preview": "vite preview",
    "electron:compile": "tsc -p tsconfig.node.json",
    "electron:dev": "concurrently -k \"vite --port 3000 --host 127.0.0.1 --strictPort\" \"wait-on http://127.0.0.1:3000 && tsc -p tsconfig.node.json && electron .\"",
    "electron:build": "vite build && tsc -p tsconfig.node.json && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config.win.signAndEditExecutable=false",
    "electron:build:clean": "node -e \"require('fs').rmSync('release',{ recursive:true, force:true })\" && npm run electron:build && node -e \"require('fs').rmSync('release/win-unpacked',{ recursive:true, force:true })\"",
    "electron:build:signed": "vite build && tsc -p tsconfig.node.json && electron-builder",
    "electron:build:signed:clean": "node -e \"require('fs').rmSync('release',{ recursive:true, force:true })\" && npm run electron:build:signed && node -e \"require('fs').rmSync('release/win-unpacked',{ recursive:true, force:true })\""
  },
  "build": {
    "appId": "com.namou.app",
    "productName": "namou",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "namou-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "namou-${version}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "namou"
    },
    "portable": {
      "artifactName": "namou-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.574.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.4.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.4"
  }
}
